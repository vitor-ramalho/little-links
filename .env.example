# =================================
# Little Links - Environment Configuration
# =================================
# Copy this file to .env and update the values as needed

# =================================
# Database Configuration
# =================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=little_link

# Database connection pool settings
DB_POOL_SIZE=30

# =================================
# Application Configuration
# =================================
# Port for the API server
PORT=3000

# Environment (development, production, test)
NODE_ENV=development

# Base URL for your application (used for short link generation)
BASE_URL=http://localhost:3000

# =================================
# Authentication & Security
# =================================
# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_please

# JWT token expiration (examples: 1h, 24h, 7d, 3600)
JWT_EXPIRATION=24h

# =================================
# Frontend Configuration
# =================================
# URL where your frontend is running
NEXT_PUBLIC_API_URL=http://localhost:3000

# =================================
# Monitoring & Performance
# =================================
# Enable system monitoring
ENABLE_MONITORING=true

# Node.js memory settings
NODE_OPTIONS=--max-old-space-size=4096

# =================================
# Payment Integration (Stripe) - Optional
# =================================
# Leave empty if not using Stripe payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3001/success
STRIPE_CANCEL_URL=http://localhost:3001/cancel

# =================================
# Development Settings
# =================================
# Disable Husky during Docker builds
HUSKY=0
